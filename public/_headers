# Response headers for every static asset (Cloudflare Workers static assets).
# The build replaces the CSP placeholder with the real policy (src/integrations/csp-headers.mjs).
# Checklist and rationale: docs/security.md.
/*
  Content-Security-Policy: %CONTENT_SECURITY_POLICY%
  Strict-Transport-Security: max-age=2592000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin

# The workers.dev hosts (production Worker URL, previews and deployment URLs) duplicate the
# site: keep them out of search indexes. mmec.adv.br is the only indexable host.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex, nofollow

# Fingerprinted build output: the file name changes with the content.
# HTML and every other file keep the platform default (public, max-age=0, must-revalidate).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
