{
  "name": "mmec-site",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Institutional website of Machado Moura e Cardoso Advogados Associados.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:specimen": "node scripts/build-specimen.mjs",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check . && npm run lint:design",
    "lint:design": "node scripts/check-design-literals.mjs",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "test:a11y": "playwright test",
    "test:links": "node scripts/check-links.mjs && node scripts/check-redirects.mjs",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:lighthouse": "lhci autorun && lhci autorun --config=lighthouserc.desktop.cjs",
    "check": "npm run lint && npm run typecheck && npm run build && node scripts/check-production-build.mjs && npm run build:specimen && npm run test:html && npm run test:links && npm run test:headers && npm run test:a11y",
    "test:headers": "node scripts/check-headers.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "astro": "7.4.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "wrangler": "4.152.0"
  }
}
