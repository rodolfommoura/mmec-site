{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm install *)",
      "Bash(npm audit *)",
      "Bash(npx astro *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler delete *)",
      "Bash(rm -rf *)",
      "Read(./.env*)",
      "Read(./**/*.pem)",
      "Edit(../mmec-site-legacy/**)"
    ]
  }
}
