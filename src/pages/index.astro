---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout title={site.name} description={site.description}>
  <main id="conteudo-principal">
    <h1>{site.name}</h1>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 4rem 1rem;
  }
</style>
