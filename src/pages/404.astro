    <h1>O endereço acessado não está disponível.</h1>
    <p>
      <a href="/">Voltar à página inicial</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-section);
  }
</style>
