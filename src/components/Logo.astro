---
/**
 * Brand logo from public/brand (docs/brand.md). The artboards already include the clear space
 * (a quarter of the symbol height) on every side, so no extra margin is added here. On dark
 * bands use `tone="cream"`; the ink file is swapped in for print.
 *
 * The horizontal artboard carries more transparent margin than the clear space requires, which
 * made the wordmark render at about 6 px. Its layout box is therefore trimmed to the artwork
 * plus the clear space, and its size comes from tokens.css (see the style block).
 */
import { site } from "../config/site";

type Variant = "horizontal" | "stacked" | "symbol";
type Tone = "ink" | "cream";

interface Props {
  variant?: Variant;
  tone?: Tone;
  /** Empty when the logo sits next to visible text with the same name. */
  alt?: string;
  loading?: "eager" | "lazy";
}

// Artboard sizes of the files in public/brand/svg and the default rendered width (brand.md
// minimums). The width and height attributes only reserve space; CSS sets the final size.
const files: Record<Variant, { artboard: [number, number]; width: number; name: string }> = {
  horizontal: { artboard: [3600, 1200], width: 300, name: "mmec-logo-horizontal" },
  stacked: { artboard: [2000, 2000], width: 200, name: "mmec-logo-stacked" },
  symbol: { artboard: [2000, 2000], width: 64, name: "mmec-symbol" },
};

const { variant = "horizontal", tone = "ink", alt = site.name, loading = "lazy" } = Astro.props;

const file = files[variant];
const width = file.width;
const height = Math.round((width * file.artboard[1]) / file.artboard[0]);
const src = (fileTone: Tone) => `/brand/svg/${file.name}-${fileTone}.svg`;
---

<img
  class:list={["logo", `logo-${variant}`, { "logo-screen-only": tone === "cream" }]}
  src={src(tone)}
  {width}
  {height}
  {alt}
  {loading}
  decoding="async"
/>
{tone === "cream" && (
  <img
    class:list={["logo", `logo-${variant}`, "logo-print-only"]}
    src={src("ink")}
    {width}
    {height}
    alt=""
    loading="lazy"
    decoding="async"
  />
)}

<style>
  /* The brand minimum wins over the global `max-width: 100%` for images. */
  .logo {
    flex: none;
    max-width: none;
  }

  /*
   * Horizontal artboard: 3600 x 1200 units, artwork from x 298 to 3318 and y 248 to 968, clear
   * space 180 units (a quarter of the 720-unit symbol). The negative margins remove only the
   * transparent margin beyond the clear space (118, 102, 68 and 52 units), so the layout box is
   * 3380 x 1080 units. `100cqi` caps the box at the width of the enclosing query container, so
   * the page never scrolls sideways on the narrowest screens.
   */
  .logo-horizontal {
    --logo-box: min(var(--logo-horizontal-width), calc(100cqi * 3600 / 3380));

    width: var(--logo-box);
    height: auto;
    margin-block: calc(var(--logo-box) * -68 / 3600) calc(var(--logo-box) * -52 / 3600);
    margin-inline: calc(var(--logo-box) * -118 / 3600) calc(var(--logo-box) * -102 / 3600);
  }
</style>
