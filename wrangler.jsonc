{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preview Worker. The production Worker "mmec" is not touched until Phase 8.
  "name": "mmec-site",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  "previews": {},
}
